# Copy to .env on the server. Never commit real credentials.
# Use independent random hex passwords (e.g. openssl rand -hex 32).
# PostgreSQL/Redis passwords below are embedded in URLs: use hex to avoid URL escaping.
HTTP_PORT=8080
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=

# At least 32 UTF-8 bytes for APP_JWT_SECRET.
APP_JWT_SECRET=
# One value maps to Java AI_RAG_SERVICE_TOKEN and Python RAG_SERVICE_TOKEN.
RAG_SERVICE_TOKEN=
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxDirectMemorySize=64m

DEFAULT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3

# When enabled, supply a working rerank key (it may equal the embedding key).
RAG_RERANK_ENABLED=true
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CANDIDATE_K=20
